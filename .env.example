OPENAI_API_KEY=
TAVILY_API_KEY=
WIKIPEDIA_USER_EMAIL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=false
LANGSMITH_PROJECT=research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional server settings (see src/settings.py). Defaults are shown.
# Set APP_API_KEY before exposing the app to anyone else.
# APP_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_FAST_MODEL=            # defaults to OPENAI_MODEL
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=3
# LLM_PRICE_INPUT_PER_1M=       # set both prices to show an estimated cost
# LLM_PRICE_OUTPUT_PER_1M=
# RATE_LIMIT_PER_HOUR=20        # per client, 0 turns it off
# MAX_CONCURRENT_RUNS=3
# TRUST_PROXY=false             # true only behind a reverse proxy that sets X-Forwarded-For
# RUN_TTL_SECONDS=600
# DATA_DIR=./data
# LOG_LEVEL=INFO
